# Required: Anthropic API key for generation, extraction, critic, and advisor passes.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Google API key, only needed if you select a Gemini model in the GUI.
# GOOGLE_API_KEY=...

# Optional: live BVA-decision verification API.
# When set, the validator performs an additional API lookup for citations that
# are not found in the sentinel-tagged source packet. This distinguishes
# HALLUCINATED (not in sources AND not in live corpus) from UNGROUNDED
# (in live corpus but the model did not actually retrieve it).
# BVA_API_URL=https://your-bva-api.example.com

# Optional: HTTP port for the local web GUI (defaults to 4000).
# PORT=4000
