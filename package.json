{
  "name": "citation-validator",
  "version": "1.0.0",
  "description": "Post-generation hallucination validator for LLM citations and structured references in RAG pipelines",
  "license": "MIT",
  "author": "Christopher Combs",
  "type": "module",
  "main": "validator.js",
  "scripts": {
    "start": "node server.js",
    "cli": "node validator.js",
    "validate": "node validator.js",
    "test:fixes": "node fixes.js",
    "test:regression": "node tests/regression/runner.js",
    "test": "npm run test:fixes && npm run test:regression",
    "validate:ungrounded": "node validator.js --ungrounded",
    "optimize": "node validator.js --optimize"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.3.1"
  }
}
